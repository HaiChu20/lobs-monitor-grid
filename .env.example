# Copy this file to `.env.local` (which is gitignored) and adjust.
#
#   cp .env.example .env.local

# --- frontend (must be prefixed VITE_ to reach the browser) ---
# Only set if the API is on a DIFFERENT origin than the UI. Same-origin = leave unset.
# VITE_API_BASE=

# --- backend (server-only; NOT exposed to the browser) ---
# Shared secret the cPouta agent must send as `Authorization: Bearer <token>`
# on POST /ingest. If unset, the server accepts unauthenticated pushes (dev only).
INGEST_TOKEN=dev-local-token

# Where the dashboard persists its state so it survives restarts.
# Dev default: ./.data   |   Rahti: set to the PVC mount path, e.g. /data
# STATE_DIR=/data
# How many days of incident history to keep (default 90).
# RETENTION_DAYS=90

# Username/password gate for the dashboard UI + API (HTTP Basic Auth). Set BOTH
# to require login; leave unset to disable (dev). /healthz and /ingest are exempt.
# DASH_USER=ops
# DASH_PASS=change-me
